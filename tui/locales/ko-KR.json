{
  "<div id=\"side\">\n  %s\n  <h1>Red Hat<br>Test Exam</h1>\n  <span class=\"timer\" id=\"timer\">Time remaining: --:--</span>\n  %s\n  <div class=\"count\">%d task%s</div>\n  <div class=\"count\"><a href=\"/\">Exam paper</a> · <a href=\"/vm\">VM control</a></div>\n  <div class=\"count\"><a href=\"/grade\">Grade</a> · <a href=\"/report\">Report</a> · <a href=\"/stats\">Stats</a></div>\n</div>": "<div id=\"side\">\n  %s\n  <h1>Red Hat<br>모의시험</h1>\n  <span class=\"timer\" id=\"timer\">남은 시간: --:--</span>\n  %s\n  <div class=\"count\">%d개 문제%s</div>\n  <div class=\"count\"><a href=\"/\">시험 문제</a> · <a href=\"/vm\">가상 머신 제어</a></div>\n  <div class=\"count\"><a href=\"/grade\">채점</a> · <a href=\"/report\">보고서</a> · <a href=\"/stats\">학습 통계</a></div>\n</div>",
  "<script>\nvar END=%d, NOW0=%d, T0=Date.now()/1000;\nfunction fmt(s){ if(s<=0) return \"Time's up\"; s=Math.floor(s);\n  var h=Math.floor(s/3600), m=Math.floor((s%%3600)/60), sec=s%%60, p=function(n){return(n<10?'0':'')+n;};\n  return (s<300)? (m+':'+p(sec)) : (h+':'+p(m)); }\nvar UNTIMED=%s, START=%d;\nfunction tick(){ var el=document.getElementById('timer'); if(!el) return;\n  if(UNTIMED){ var e=Math.max(0,Math.floor(NOW0-START+(Date.now()/1000-T0))), h=Math.floor(e/3600), m=Math.floor((e%%3600)/60);\n    el.textContent='Practice (untimed) · '+h+':'+(m<10?'0':'')+m+' elapsed'; el.className='timer'; return; }\n  var rem=END-NOW0-(Date.now()/1000-T0);\n  el.textContent='Time remaining: '+fmt(rem); el.className=(rem<300)?'timer low':'timer'; }\nsetInterval(tick,1000); tick();\nfunction postMark(id,st){ fetch('/api/mark',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},\n  body:'id='+encodeURIComponent(id)+'&state='+st}); }\n</script>": "<script>\nvar END=%d, NOW0=%d, T0=Date.now()/1000;\nfunction fmt(s){ if(s<=0) return \"시간 종료\"; s=Math.floor(s);\n  var h=Math.floor(s/3600), m=Math.floor((s%%3600)/60), sec=s%%60, p=function(n){return(n<10?'0':'')+n;};\n  return (s<300)? (m+':'+p(sec)) : (h+':'+p(m)); }\nvar UNTIMED=%s, START=%d;\nfunction tick(){ var el=document.getElementById('timer'); if(!el) return;\n  if(UNTIMED){ var e=Math.max(0,Math.floor(NOW0-START+(Date.now()/1000-T0))), h=Math.floor(e/3600), m=Math.floor((e%%3600)/60);\n    el.textContent='연습(시간 제한 없음) · '+h+':'+(m<10?'0':'')+m+' 경과'; el.className='timer'; return; }\n  var rem=END-NOW0-(Date.now()/1000-T0);\n  el.textContent='남은 시간: '+fmt(rem); el.className=(rem<300)?'timer low':'timer'; }\nsetInterval(tick,1000); tick();\nfunction postMark(id,st){ fetch('/api/mark',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},\n  body:'id='+encodeURIComponent(id)+'&state='+st}); }\n</script>",
  "<div style='background:#e6f4ea;border:1px solid #4a9a5e;padding:11px 14px;margin-bottom:14px;border-radius:3px;font-size:15px;'>&#9989; <b>Your exam has been graded</b> (persistence checked after the reboot). <a class='biglink' href='/report'>View your scored report &rarr;</a></div>": "<div style='background:#e6f4ea;border:1px solid #4a9a5e;padding:11px 14px;margin-bottom:14px;border-radius:3px;font-size:15px;'>&#9989; <b>채점이 완료되었습니다</b> (재부팅 후 설정 유지 여부를 확인했습니다). <a class='biglink' href='/report'>채점 보고서 보기 &rarr;</a></div>",
  "<div style='background:#fff3cd;border:1px solid #d9a900;padding:11px 14px;margin-bottom:14px;border-radius:3px;font-size:15px;'>&#8987; <b>Grading after the reboot &mdash; in progress&hellip;</b> This takes a minute or two (the peer node is graded too). The page refreshes automatically; the score appears here when it is ready.<script>setTimeout(function(){location.reload();},8000);</script></div>": "<div style='background:#fff3cd;border:1px solid #d9a900;padding:11px 14px;margin-bottom:14px;border-radius:3px;font-size:15px;'>&#8987; <b>재부팅 후 채점 중&hellip;</b> 다른 노드를 포함하여 채점하는 데 1~2분 정도 걸립니다. 페이지는 자동으로 새로고침되며, 완료되면 결과가 표시됩니다.<script>setTimeout(function(){location.reload();},8000);</script></div>",
  "<div style='background:#e8f5e9;border:1px solid #88aa88;padding:9px 13px;margin-bottom:14px;border-radius:3px;font-size:14px;'><b>Practice mode</b> — learning aids are on. Open any task for <b>Hint</b>, <b>Solution</b> and <b>Check my work</b> (a real exam, mock or drill stays aid-free).</div>": "<div style='background:#e8f5e9;border:1px solid #88aa88;padding:9px 13px;margin-bottom:14px;border-radius:3px;font-size:14px;'><b>연습 모드</b> — 학습 보조 기능이 활성화되어 있습니다. 문제를 열면 다음 기능을 사용할 수 있습니다: <b>힌트</b>, <b>해설</b> and <b>풀이 확인</b> (시험, 모의시험, 시간제한 훈련에서는 학습 보조 기능을 제공하지 않습니다).</div>",
  "<h2>Configuration Information</h2>": "<h2>구성 정보</h2>",
  "<p class='intro'>Before you begin, you should review some general configuration information outlined in the following link:</p>": "<p class='intro'>시작하기 전에 다음 링크의 일반적인 시스템 구성 정보를 확인하십시오.</p>",
  "Red Hat Test Exam": "Red Hat 모의시험",
  "<div class='row'>%s <a class='biglink' href='/config'>Important configuration information</a></div>": "<div class='row'>%s <a class='biglink' href='/config'>주요 구성 정보</a></div>",
  "Configure your system %s": "시스템 구성 %s",
  "<div class='host'>Perform the following tasks on <code>%s</code>.</div>": "<div class='host'>다음 시스템에서 작업을 수행하십시오: <code>%s</code>.</div>",
  "<label><input type='radio' name='%s' value='revisit' %s onclick=\"postMark('%s','revisit')\"> Revisit</label><label><input type='radio' name='%s' value='done' %s onclick=\"postMark('%s','done')\"> Done</label>": "<label><input type='radio' name='%s' value='revisit' %s onclick=\"postMark('%s','revisit')\"> 다시 확인</label><label><input type='radio' name='%s' value='done' %s onclick=\"postMark('%s','done')\"> 완료</label>",
  "<h2>Important configuration information</h2>": "<h2>주요 구성 정보</h2>",
  "<p class='intro'>During the exam you work with the virtual system(s) listed below; you have full root access to them.</p>": "<p class='intro'>시험에서는 아래 가상 시스템을 사용합니다. 각 시스템에 대한 root 권한이 제공됩니다.</p>",
  "<h3>System Information</h3>": "<h3>시스템 정보</h3>",
  "The systems are members of the DNS domain <b>%s</b>": "시스템의 DNS 도메인은 <b>%s</b>입니다",
  "<h3>Account Information</h3>": "<h3>계정 정보</h3>",
  "<h3>Other Information</h3>": "<h3>기타 정보</h3>",
  "<p>You may access the systems via SSH or the console. Packages install <b>offline</b> from the attached DVD repository. After completing a task you may <b>reboot</b> a system to verify your changes persist, then reopen this exam with <code>rhcsa-sim tui</code> &mdash; your progress and the remaining time are preserved. When you are finished, grade with <code>rhcsa-sim grade --reboot</code> (pass mark <b>210/300</b>).</p>": "<p>SSH 또는 콘솔로 시스템에 접근할 수 있습니다. 패키지는 연결된 DVD 저장소에서 <b>오프라인</b>으로 설치합니다. 작업 후 시스템을 <b>재부팅</b>하여 설정이 유지되는지 확인할 수 있습니다. <code>rhcsa-sim tui</code>로 시험 화면을 다시 열면 진행 상태와 남은 시간이 유지됩니다. 모든 작업을 마치면 <code>rhcsa-sim grade --reboot</code>로 채점하십시오(합격 기준: <b>210/300</b>).</p>",
  "<p><a class='btn' href='/'>&larr; Back to exam paper</a></p>": "<p><a class='btn' href='/'>&larr; 시험 문제로 돌아가기</a></p>",
  "Configuration Information": "구성 정보",
  "<tr><th style='%s'>System</th><th style='%s'>IP Address</th></tr>": "<tr><th style='%s'>시스템</th><th style='%s'>IP 주소</th></tr>",
  ", and all systems are in the <b>%s</b> subnet": "이며, 모든 시스템은 <b>%s</b> 서브넷에 속합니다",
  "<p>%s. The IP addresses listed are the addresses that <b>should</b> be assigned to the systems; you may need to configure the network to reach them.</p>": "<p>%s. 위 IP 주소는 각 시스템에 <b>할당해야 하는</b> 주소입니다. 해당 주소로 접속하려면 네트워크 설정이 필요할 수 있습니다.</p>",
  " Reach %s with <code>ssh student@%s</code> then <code>sudo -i</code> (root SSH may be disabled by a task &mdash; use student + sudo).": " %s에는 <code>ssh student@%s</code>로 접속한 뒤 <code>sudo -i</code>를 실행하십시오. 문제에 따라 root의 SSH 접속이 제한될 수 있으므로 student와 sudo를 사용하십시오.",
  "<p>Log in as <b>student</b> / <b>password</b>; become root with <code>sudo -i</code>.%s</p>": "<p><b>student</b> / <b>password</b>로 로그인한 뒤 <code>sudo -i</code>로 root가 되십시오.%s</p>",
  "<p>The <b>root</b> password for %s has been set to <b>&quot;%s&quot;</b>. Unless otherwise specified, this is the password you use for other accounts you create and for services that require a password.</p>": "<p>%s의 <b>root</b> 암호는 <b>&quot;%s&quot;</b>로 설정되어 있습니다. 별도 지시가 없으면 새로 생성하는 계정과 암호가 필요한 서비스에도 이 암호를 사용하십시오.</p>",
  "<p>The <b>root</b> password for %s is <b>not provided</b> &mdash; you must reset it as instructed (see the <i>Reset Root Password</i> task).</p>": "<p>%s의 <b>root</b> 암호는 <b>제공되지 않습니다</b>. <i>root 암호 재설정</i> 문제의 지시에 따라 직접 재설정하십시오.</p>",
  "<p>Log in to %s as <b>student</b> / <b>password</b> and become root with <code>sudo -i</code>.</p>": "<p>%s에 <b>student</b> / <b>password</b>로 로그인한 뒤 <code>sudo -i</code>로 root가 되십시오.</p>",
  "<p>The <b>root</b> password for %s is <b>not provided</b> &mdash; you must reset it yourself as instructed (the <i>Reset Root Password</i> task on %s).</p>": "<p>%s의 <b>root</b> 암호는 <b>제공되지 않습니다</b>. %s의 <i>root 암호 재설정</i> 문제에 따라 직접 재설정하십시오.</p>",
  "<p class='note'>Perform on <code>%s</code></p>": "<p class='note'>작업 대상: <code>%s</code></p>",
  "<div class='row'>Mark: %s</div>": "<div class='row'>표시: %s</div>",
  "<p class='note'>(Exam mode — no answers or self-check, like the real exam. Use a terminal to do the task, then grade when finished.)</p>": "<p class='note'>(시험 모드에서는 실제 시험과 같이 정답과 풀이 확인 기능을 제공하지 않습니다. 터미널에서 작업을 수행한 뒤 완료하면 채점하십시오.)</p>",
  "Task %s": "문제 %s",
  "<h2>Unknown task</h2><p>'%s' is not in this exam.</p><p><a class='btn' href='/'>&larr; Back</a></p>": "<h2>알 수 없는 문제</h2><p>'%s'는 이 시험의 문제가 아닙니다.</p><p><a class='btn' href='/'>&larr; 돌아가기</a></p>",
  "<p><button class='btn' onclick=\"aid('hint')\">Hint</button><button class='btn' onclick=\"aid('solution')\">Solution</button><button class='btn red' onclick=\"chk()\">Check my work</button></p><div id='out'></div><script>var TID=%s;function show(t){document.getElementById('out').innerHTML='<pre>'+t.replace(/&/g,'&amp;').replace(/</g,'&lt;')+'</pre>';}function aid(k){show('Loading ...');fetch('/api/aid',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'id='+encodeURIComponent(TID)+'&kind='+k}).then(r=>r.text()).then(function(t){if(k=='solution'){document.getElementById('out').innerHTML=t;}else{show(t);}});}function chk(){show('Checking ...');fetch('/api/check',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'id='+encodeURIComponent(TID)}).then(r=>r.text()).then(show);}</script>": "<p><button class='btn' onclick=\"aid('hint')\">힌트</button><button class='btn' onclick=\"aid('solution')\">해설</button><button class='btn red' onclick=\"chk()\">풀이 확인</button></p><div id='out'></div><script>var TID=%s;function show(t){document.getElementById('out').innerHTML='<pre>'+t.replace(/&/g,'&amp;').replace(/</g,'&lt;')+'</pre>';}function aid(k){show('Loading ...');fetch('/api/aid',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'id='+encodeURIComponent(TID)+'&kind='+k}).then(r=>r.text()).then(function(t){if(k=='solution'){document.getElementById('out').innerHTML=t;}else{show(t);}});}function chk(){show('Checking ...');fetch('/api/check',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'id='+encodeURIComponent(TID)}).then(r=>r.text()).then(show);}</script>"
}
